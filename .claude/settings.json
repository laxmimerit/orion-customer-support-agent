{
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-env-commit.sh",
            "onFailure": "block",
            "statusMessage": "Checking the commit for env files"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-api-tests.sh",
            "timeout": 120,
            "statusMessage": "Running the API tests"
          }
        ]
      }
    ]
  }
}
